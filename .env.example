DATABASE_URL=postgresql://user:password@localhost:5432/dsa_trainer

NEXTAUTH_URL=http://localhost:3000

# NextAuth v5 reads AUTH_SECRET; NEXTAUTH_SECRET still works as a fallback.
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here
NEXTAUTH_SECRET=your_auth_secret_here

GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="DSA Trainer <no-reply@example.com>"

NEXT_PUBLIC_APP_URL=http://localhost:3000

CRON_SECRET=your_long_random_string_for_cron_protection
