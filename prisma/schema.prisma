generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  accessToken   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  repos       Repo[]
  revisions   Revision[]
  accounts    Account[]
  sessions    Session[]
  roadmap     RoadmapProgress?
  practice    PracticeAttempt[]
  diagnostics DiagnosticItem[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Repo {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName      String
  defaultBranch String   @default("main")
  webhookSecret String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  problems Problem[]

  @@unique([userId, fullName])
  @@index([userId])
}

model Problem {
  id     String @id @default(cuid())
  repoId String
  repo   Repo   @relation(fields: [repoId], references: [id], onDelete: Cascade)

  path       String
  platform   String?
  difficulty String?
  pattern    String?
  title      String
  language   String?
  sha        String
  solvedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  revisions  Revision[]
  recallNote RecallNote?
  attempts   Attempt[]
  mistakes   Mistake[]

  @@unique([repoId, path])
  @@index([repoId])
  @@index([platform])
  @@index([difficulty])
  @@index([pattern])
  @@index([solvedAt])
}

model Revision {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  nextDate        DateTime
  lastRevised     DateTime?
  // Newest judge solve already folded into the schedule, so a re-sync that
  // re-reports the same commit dates cannot credit it twice.
  lastSolveCredit DateTime?
  intervalDays    Int       @default(1)
  easeFactor      Float     @default(2.5)
  repetitions     Int       @default(0)
  lapses          Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, problemId])
  @@index([userId])
  @@index([problemId])
  @@index([nextDate])
}

model RecallNote {
  id        String  @id @default(cuid())
  problemId String  @unique
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  keyIdea    String?  @db.Text
  approach   String?  @db.Text
  edgeCases  String?  @db.Text
  complexity String?
  hints      String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Attempt {
  id        String  @id @default(cuid())
  userId    String
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  rating            String
  // "recall" for an in-app rating, "solve" for a re-solve on the judge; only
  // the former is evidence of recall, so recall stats filter on it.
  source            String   @default("recall")
  patternRecognized Boolean?
  hintsUsed         Int      @default(0)
  durationSec       Int?
  explanation       String?  @db.Text
  createdAt         DateTime @default(now())

  @@index([userId, problemId])
  @@index([userId, createdAt])
  @@index([userId, source, createdAt])
}

model Mistake {
  id        String  @id @default(cuid())
  userId    String
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  description String   @db.Text
  concept     String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([problemId])
}

// Learning-roadmap progress (trees, 30-day plans, portfolio projects) as one
// document per user; the shape is owned by lib/roadmap/progress.ts.
model RoadmapProgress {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A first attempt at a ladder problem (lib/pattern-ladder.ts). Deliberately not
// a Problem row: nothing here lives in the user's repo, there is no file to
// diff and no solution to reveal, and a ladder problem that later shows up in a
// sync must not be double-counted as solved.
model PracticeAttempt {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Rung id from the ladder catalog, not a lib/constants pattern value.
  rungId        String
  slug          String
  tier          String
  difficulty    String
  /// unaided | hinted | editorial | failed — see lib/practice.ts. The whole
  /// readiness rule rests on this column, so it is never nullable.
  outcome       String
  durationSec   Int?
  /// What the pattern was called before the editor was opened, when asked.
  patternGuess  String?
  notes         String?   @db.Text
  /// When a non-unaided attempt has to be re-derived from blank; null once paid.
  debtDueAt     DateTime?
  debtClearedAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, rungId, createdAt])
  @@index([userId, slug])
  @@index([userId, debtDueAt])
}

// One statement from a blind diagnostic run. Stored per item rather than per run
// so recognition can be read per pattern, which is how a rung's blind check is
// computed without replaying whole sessions.
model DiagnosticItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  runId   String
  slug    String
  rungId  String
  /// The lib/constants pattern the statement actually trains.
  pattern String
  guess   String?
  correct Boolean
  seconds Int?

  createdAt DateTime @default(now())

  @@index([userId, pattern, createdAt])
  @@index([userId, runId])
}
